# Server
PORT=5000
NODE_ENV=development

# MongoDB (Local — for development)
MONGO_URI=mongodb://127.0.0.1:27017/siras-ccl

# MongoDB (Atlas — uncomment this later for production)
# MONGO_URI=mongodb+srv://yourUsername:yourPassword@cluster0.xxxxx.mongodb.net/siras-ccl?retryWrites=true&w=majority

# JWT Secret (we'll use this in auth steps later)
JWT_SECRET=siras_ccl_secret_key_2026_change_this_in_production

# Admin credentials (for seeding default admin later)
ADMIN_EMAIL=admin@ccl.co.in
ADMIN_PASSWORD=admin123